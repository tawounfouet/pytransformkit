  "critical_error_mappings": {
    "contradictory_options": {
      "category": "invalid_usage",
      "exit_code": 2
    },
    "unknown_engine_id": {
      "category": "invalid_usage",
      "exit_code": 2
    },
    "unknown_contract_id": {
      "category": "invalid_usage",
      "exit_code": 2
    },
    "PTK-DECL-010": {
      "category": "missing_optional_dependency",
      "exit_code": 11
    },
    "filesystem_failure": {
      "category": "filesystem_error",
      "exit_code": 12
    },
    "remote_source": {
      "category": "unsupported_operation",
      "exit_code": 13
    },
    "keyboard_interrupt": {
      "category": "interrupted",
      "exit_code": 130
    },
    "broken_pipe": {
      "category": "broken_pipe",
      "exit_code": 141
    }
  },
